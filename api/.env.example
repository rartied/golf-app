# Backend config. Copy to api/.env (local) or /opt/golf/repo/.env (prod).
# SQLAlchemy + psycopg URL (note the +psycopg driver suffix).
DATABASE_URL=postgresql+psycopg://golf:CHANGEME@localhost:5432/golf
# Secret for signing JWTs — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# Base URL used to build invite registration links.
PUBLIC_BASE_URL=https://golf.jbohlen.dev
