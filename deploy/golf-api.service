[Unit]
Description=Golf Tracker FastAPI Server
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/golf/repo
EnvironmentFile=/opt/golf/repo/.env
ExecStart=/opt/golf/repo/api/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60s
SyslogIdentifier=golf-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
